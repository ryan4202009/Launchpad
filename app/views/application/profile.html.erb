<div class="profile_page">
  <div class="profile_card">
    <% if @profile_user.avatar_data.present? %>
      <img src="<%= @profile_user.avatar_data %>" alt="<%= h(@profile_user.username) %>'s profile picture" class="profile_avatar profile_avatar_image" />
    <% else %>
      <div class="profile_avatar" aria-hidden="true"><%= @profile_user.username.to_s[0, 1].to_s.upcase %></div>
    <% end %>
    <p class="profile_eyebrow">LAUNCHPAD PLAYER</p>
    <h1 class="profile_name_heading"><%= @profile_user.username %> <% if @profile_user.username.to_s.casecmp("Lookumz").zero? %><span class="owner_tag" title="Launchpad owner">OWNER</span><% end %></h1>
    <p class="profile_joined">Member since <%= @profile_user.created_at.strftime("%B %Y") %></p>

    <div class="profile_bio">
      <h2>About</h2>
      <% if @profile_user.bio.present? %>
        <p><%= simple_format(h(@profile_user.bio)) %></p>
      <% else %>
        <p class="profile_muted">This player hasn't added a bio yet.</p>
      <% end %>
    </div>

    <div class="profile_saved_songs">
      <h2>Saved Songs (<%= @profile_songs.length %>)</h2>
      <% if @profile_songs.any? %>
        <% @profile_songs.each do |song| %>
          <div class="profile_saved_song">
            <div class="profile_saved_song_info">
              <strong><%= song.name.presence || "Untitled chart" %></strong>
              <span class="profile_muted">Saved <%= song.updated_at.strftime("%b %-d, %Y") %></span>
            </div>
            <a class="profile_action" data-no-turbolink="true" href="<%= root_path(load_song_id: song.id) %>">Use song</a>
          </div>
        <% end %>
      <% else %>
        <p class="profile_muted">No saved songs yet. Save a chart from the Launchpad editor and it will appear here.</p>
      <% end %>
    </div>

    <% if @current_user && @current_user.id == @profile_user.id %>
      <a class="profile_action" data-no-turbolink="true" href="<%= edit_profile_path %>">Edit profile</a>
    <% end %>
    <a class="profile_back" data-no-turbolink="true" href="<%= root_path %>">← Back to Launchpad</a>
  </div>
</div>
